# 复制为 .env。本地试玩保持 true，仅监听本机。
DEV_MODE=true
# 仅可信局域网真机调试需要设为 true 并改 HOST；不要向公网暴露开发登录。
ALLOW_LAN_DEV=false
HOST=127.0.0.1
PORT=8787
DATA_DIR=./.data

# 正式环境必须 DEV_MODE=false，配置微信信息及 HTTPS 域名。
# 域名需加入微信 request、socket 和 uploadFile/downloadFile 合法域名。
PUBLIC_BASE_URL=
ALLOWED_ORIGINS=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 在小程序后台 开发 -> 接口设置 开通多人音视频权限后才启用。
WECHAT_VOICE_ENABLED=false

# 不配置时清楚提示使用本地引擎，永远不要在客户端写入 Key。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=6000
