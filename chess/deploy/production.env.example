# 审阅模板；本轮未开通服务器、域名或执行部署。
# 复制为 deploy/.env.production，仅在获批服务器填写；不要上传、打包或分享该私密文件。
# 只填域名，不含 https://、路径或端口。
CHESS_DOMAIN=

# 必须与宿主微信工程的真实 AppID 属于同一小程序。
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 平台实际开通多人语音权限并完成真机验证后才开启。
WECHAT_VOICE_ENABLED=false

# 可选；不配置则明确使用本地 AI 搜索。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=6000
