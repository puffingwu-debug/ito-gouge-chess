.config-row{display:flex;align-items:center;margin:14rpx 0;gap:12rpx}
.config-label{font-size:28rpx;color:#333;white-space:nowrap;min-width:140rpx}
.config-input{flex:1;background:#f7f8fa;padding:14rpx;border-radius:8rpx;font-size:28rpx}
.config-picker{flex:1;background:#f7f8fa;padding:14rpx;border-radius:8rpx;font-size:28rpx}
.picker-text{text-align:center}
.code-input{background:#f7f8fa;padding:18rpx;border-radius:8rpx;font-size:30rpx;letter-spacing:2rpx}
.grid-table{margin:18rpx 0}
.grid-header{display:flex;align-items:center;margin-bottom:10rpx}
.grid-corner{width:70rpx;flex-shrink:0}
.grid-header-cell{flex:1;text-align:center;font-size:24rpx;color:#999}
.grid-row{display:flex;align-items:center;margin-bottom:10rpx}
.grid-row-label{width:70rpx;flex-shrink:0;text-align:center;font-size:24rpx;color:#999}
.grid-cell{flex:1;min-width:0;height:72rpx;margin:0 4rpx;text-align:center;font-size:28rpx;border:1rpx solid #ddd;border-radius:8rpx;background:#f7f8fa}
.preview-img{width:100%;height:300rpx;border-radius:12rpx;margin:18rpx 0}
.ocr-loading{padding:18rpx;color:#07c160;font-size:26rpx;text-align:center}
.muted{font-size:24rpx;color:#999;margin:8rpx 0}
