/* ==================== 页面头部 ==================== */
.page-header {
  padding: 40rpx 24rpx 8rpx;
  text-align: center;
}
.page-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: #3b82f6;
}
.page-subtitle {
  display: block;
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}

/* ==================== 通用区块 ==================== */
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #172033;
  margin-bottom: 20rpx;
}
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.section-header .section-title {
  margin-bottom: 0;
}
.product-count {
  font-size: 26rpx;
}

/* ==================== 单位选择 ==================== */
.unit-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.radio-group {
  display: flex;
}
.radio-label {
  display: flex;
  align-items: center;
  margin-right: 32rpx;
  font-size: 28rpx;
  color: #374151;
}
.radio-label text {
  margin-left: 8rpx;
}

/* ==================== 输入行 ==================== */
.input-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.row-label {
  width: 150rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: #6b7280;
}
.num-input {
  flex: 1;
  background: #f7f8fa;
  padding: 18rpx 20rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #172033;
}
.unit-suffix {
  width: 60rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #9ca3af;
}

/* 原片面积提示 */
.sheet-area-tip {
  margin-top: 8rpx;
  padding: 16rpx 20rpx;
  background: #eff6ff;
  border-radius: 10rpx;
  font-size: 26rpx;
}

/* ==================== 成品表格 ==================== */
.empty-tip {
  padding: 48rpx 0;
  text-align: center;
  font-size: 28rpx;
}

.product-table {
  margin-bottom: 16rpx;
}
.table-header {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #e5e7eb;
}
.th {
  font-size: 22rpx;
  color: #9ca3af;
  font-weight: 600;
}
.table-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f1f3;
}
.td {
  font-size: 26rpx;
  color: #172033;
}
.col-len { width: 100rpx; }
.col-wid { width: 100rpx; }
.col-num { width: 180rpx; }
.col-area { flex: 1; }
.col-op { width: 110rpx; }

/* 数量增减按钮 */
.qty-cell {
  display: flex;
  align-items: center;
}
.qty-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
}
.qty-minus {
  background: #f3f4f6;
  color: #6b7280;
}
.qty-plus {
  background: #3b82f6;
  color: #fff;
}
.qty-btn:active {
  opacity: 0.7;
}
.qty-text {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #172033;
  font-weight: 600;
}

/* 操作按钮 */
.op-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}
.op-btn {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
}
.edit-btn {
  color: #3b82f6;
  background: #eff6ff;
}
.del-btn {
  color: #ef4444;
  background: #fef2f2;
}
.op-btn:active {
  opacity: 0.7;
}

/* ==================== 按钮 ==================== */
.add-btn {
  background: #eff6ff !important;
  color: #3b82f6 !important;
  border: 2rpx dashed #93c5fd;
  font-size: 28rpx;
  margin-top: 20rpx;
}
.add-btn::after {
  border: none;
}

.calc-btn {
  background: #3b82f6 !important;
  color: #fff !important;
  font-size: 32rpx;
  font-weight: 600;
  margin: 24rpx;
  border-radius: 14rpx;
  height: 88rpx;
  line-height: 88rpx;
}
.calc-btn::after {
  border: none;
}

.preview-btn {
  background: #1e40af !important;
  color: #fff !important;
  font-size: 30rpx;
  font-weight: 600;
  margin: 24rpx;
  border-radius: 14rpx;
  height: 84rpx;
  line-height: 84rpx;
}
.preview-btn::after {
  border: none;
}

/* ==================== 计算结果 ==================== */
.result-card {
  border-top: 6rpx solid #3b82f6;
}

.stat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.stat-item {
  flex: 1;
  min-width: 44%;
  background: #f7f8fa;
  padding: 24rpx 20rpx;
  border-radius: 14rpx;
  text-align: center;
}
.stat-label {
  display: block;
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 10rpx;
}
.stat-value {
  font-size: 38rpx;
  font-weight: 700;
  color: #172033;
}
.stat-unit {
  font-size: 24rpx;
  color: #9ca3af;
  margin-left: 4rpx;
}
.stat-good {
  color: #10b981;
}
.stat-warn {
  color: #f59e0b;
}

/* 溢出警告 */
.warning-box {
  background: #fef2f2;
  border-radius: 14rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #fecaca;
}
.warning-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #ef4444;
  margin-bottom: 14rpx;
}
.warning-item {
  font-size: 25rpx;
  color: #991b1b;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

/* 优化建议 */
.suggestion-box {
  background: #fffbeb;
  border-radius: 14rpx;
  padding: 24rpx;
  border: 1rpx solid #fde68a;
}
.suggestion-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #d97706;
  margin-bottom: 14rpx;
}
.suggestion-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 25rpx;
  color: #92400e;
  margin-bottom: 14rpx;
}
.suggestion-item:last-child {
  margin-bottom: 0;
}
.suggestion-text {
  flex: 1;
  line-height: 1.5;
}
.apply-btn {
  flex-shrink: 0;
  color: #3b82f6;
  font-size: 26rpx;
  padding: 10rpx 24rpx;
  background: #eff6ff;
  border-radius: 8rpx;
  margin-left: 16rpx;
}
.apply-btn:active {
  opacity: 0.7;
}

/* 成功提示 */
.success-tip {
  background: #ecfdf5;
  border-radius: 14rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #059669;
  border: 1rpx solid #a7f3d0;
}

/* ==================== 弹窗 ==================== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-content {
  background: #fff;
  border-radius: 24rpx;
  width: 88%;
  padding: 40rpx 36rpx;
}
.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #172033;
  text-align: center;
  margin-bottom: 28rpx;
}

.max-qty-tip {
  background: #eff6ff;
  padding: 16rpx 20rpx;
  border-radius: 10rpx;
  margin: 16rpx 0;
  text-align: center;
  color: #3b82f6;
  font-size: 26rpx;
}

.modal-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}
.modal-btn {
  flex: 1;
  margin: 0;
  font-size: 27rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 10rpx;
}
.modal-btn::after {
  border: none;
}
.calc-max-btn {
  background: #f0f9ff !important;
  color: #3b82f6 !important;
  border: 2rpx solid #93c5fd;
}
.cancel-btn {
  background: #f3f4f6 !important;
  color: #6b7280 !important;
}
.save-btn {
  background: #3b82f6 !important;
  color: #fff !important;
}

/* ==================== 页脚 ==================== */
.footer {
  text-align: center;
  padding: 40rpx 0 60rpx;
  font-size: 24rpx;
}
